<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"
        tools:ignore="MissingPermission" />
    
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AIAssistantApplication"
        android:allowBackup="true"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersianAIAssistant"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".activities.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.PersianAIAssistant.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.PersianAIAssistant" />

        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.PersianAIAssistant" />

        <activity
            android:name=".activities.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.PersianAIAssistant" />

        <activity
            android:name=".activities.NotificationCommandActivity"
            android:exported="false"
            android:theme="@style/Theme.PersianAIAssistant" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.PersianAIAssistant.Splash" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
            
        <activity
            android:name=".activities.WidgetSettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.SettingsActivity" />
            
        <activity
            android:name=".activities.ApiSettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.SettingsActivity" />

        <activity
            android:name=".activities.RemindersActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.AdvancedRemindersActivity"
            android:exported="false"
            android:parentActivityName=".activities.DashboardActivity" />

        <activity
            android:name=".activities.ReminderChatActivity"
            android:exported="false"
            android:parentActivityName=".activities.AdvancedRemindersActivity" />

        <activity
            android:name=".activities.ExpensesActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.WeatherActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
            
        <activity
            android:name=".activities.WeatherForecastActivity"
            android:exported="false"
            android:parentActivityName=".activities.WeatherActivity" />
            
        <activity
            android:name=".activities.WeatherSearchActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
            
        <activity
            android:name=".activities.MusicActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.CalendarActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.AlarmActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".activities.ConversationsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <service
            android:name=".services.VoiceCommandService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".activities.ConnectedAppsActivity"
            android:exported="false"
            android:parentActivityName=".activities.SettingsActivity" />

        <activity
            android:name=".activities.AccessibilityGuideActivity"
            android:exported="false"
            android:parentActivityName=".activities.SettingsActivity" />

        <activity
            android:name=".activities.NavigationActivity"
            android:exported="false"
            android:parentActivityName=".activities.DashboardActivity" />

        <!-- Voice-only Navigation Assistant -->
        <activity
            android:name=".activities.VoiceNavigationAssistantActivity"
            android:exported="true"
            android:parentActivityName=".activities.DashboardActivity">
            <!-- دریافت اشتراک‌گذاری مقصد از سایر اپ‌ها -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- پشتیبانی از geo: -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- لینک‌های http/https نقشه (Google / Neshan) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" />
                <data android:scheme="https" android:host="google.com" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="neshan.org" />
                <data android:scheme="https" android:host="neshan.ir" />
                <data android:scheme="http" android:host="maps.google.com" />
                <data android:scheme="http" android:host="www.google.com" />
                <data android:scheme="http" android:host="google.com" />
                <data android:scheme="http" android:host="maps.app.goo.gl" />
                <data android:scheme="http" android:host="neshan.org" />
                <data android:scheme="http" android:host="neshan.ir" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".activities.RealNavigationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".activities.NavigationActivity" />

        <activity
            android:name=".activities.AccountingActivity"
            android:exported="false"
            android:parentActivityName=".activities.DashboardActivity" />

        <activity
            android:name=".activities.AccountingAdvancedActivity"
            android:exported="false"
            android:parentActivityName=".activities.AccountingActivity" />

        <activity
            android:name=".activities.IncomeListActivity"
            android:exported="false"
            android:parentActivityName=".activities.AccountingAdvancedActivity" />

        <activity
            android:name=".activities.ExpenseListActivity"
            android:exported="false"
            android:parentActivityName=".activities.AccountingAdvancedActivity" />

        <activity
            android:name=".activities.CheckListActivity"
            android:exported="false"
            android:parentActivityName=".activities.AccountingAdvancedActivity" />

        <activity
            android:name=".activities.InstallmentListActivity"
            android:exported="false"
            android:parentActivityName=".activities.AccountingAdvancedActivity" />

        <activity
            android:name=".activities.AccountingChatActivity"
            android:exported="false"
            android:parentActivityName=".activities.AccountingAdvancedActivity" />
            
        <!-- ✅ NEW: Checks Management Activity -->
        <activity
            android:name=".activities.ChecksManagementActivity"
            android:exported="false"
            android:label="مدیریت چک‌ها"
            android:parentActivityName=".activities.MainActivity" />
            
        <!-- ✅ NEW: Installments Management Activity -->
        <activity
            android:name=".activities.InstallmentsManagementActivity"
            android:exported="false"
            android:label="مدیریت اقساط"
            android:parentActivityName=".activities.MainActivity" />
            
        <!-- ✅ NEW: Finance Advanced Activity -->
        <activity
            android:name=".activities.FinanceAdvancedActivity"
            android:exported="false"
            android:label="مالی پیشرفته"
            android:parentActivityName=".activities.MainActivity" />
            
        <!-- ✅ NEW: Professional Accounting Activity -->
        <activity
            android:name=".activities.ProfessionalAccountingActivity"
            android:exported="false"
            android:label="حسابداری حرفه‌ای"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.SearchDestinationActivity"
            android:exported="false"
            android:parentActivityName=".activities.NavigationActivity" />

        <activity
            android:name=".activities.AIChatActivity"
            android:exported="false"
            android:parentActivityName=".activities.NavigationActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.VoiceCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PersianAIAssistant.Transparent" />
            
        <activity
            android:name=".activities.GenericInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.PersianAIAssistant" />

        <!-- مشاور روان و خودشناسی -->
        <activity
            android:name=".activities.PsychologyChatActivity"
            android:exported="false"
            android:label="مشاور آرامش"
            android:parentActivityName=".activities.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- مشاور مسیر شغلی -->
        <activity
            android:name=".activities.CareerChatActivity"
            android:exported="false"
            android:label="مشاور مسیر"
            android:parentActivityName=".activities.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- دفتر مشتریان -->
        <activity
            android:name=".activities.CRMChatActivity"
            android:exported="false"
            android:label="دفتر مشتریان"
            android:parentActivityName=".activities.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- بانک اسناد -->
        <activity
            android:name=".activities.DocumentChatActivity"
            android:exported="false"
            android:label="بانک اسناد"
            android:parentActivityName=".activities.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- پیشنهاد فرهنگی -->
        <activity
            android:name=".activities.CulturalChatActivity"
            android:exported="false"
            android:label="پیشنهاد فرهنگی"
            android:parentActivityName=".activities.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- ذخیره مکان مشترک -->
        <activity
            android:name=".ui.SharedLocationActivity"
            android:exported="true"
            android:label="ذخیره مکان"
            android:parentActivityName=".ui.NamedLocationsActivity">

            <!-- دریافت اشتراک‌گذاری مقصد از Google Maps / Neshan (متن ساده) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- پشتیبانی از geo: -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>

            <!-- لینک‌های http/https نقشه (Google / Neshan) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" />
                <data android:scheme="https" android:host="google.com" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="neshan.org" />
                <data android:scheme="https" android:host="neshan.ir" />
                <data android:scheme="http" android:host="maps.google.com" />
                <data android:scheme="http" android:host="www.google.com" />
                <data android:scheme="http" android:host="google.com" />
                <data android:scheme="http" android:host="maps.app.goo.gl" />
                <data android:scheme="http" android:host="neshan.org" />
                <data android:scheme="http" android:host="neshan.ir" />
            </intent-filter>
        </activity>

        <!-- Named locations management -->
        <activity
            android:name=".ui.NamedLocationsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="مکان‌های من" />

        <activity
            android:name=".activities.FullScreenAlarmActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="stateHidden" />

        <!-- Call Confirmation Activity -->
        <activity
            android:name=".activities.CallConfirmationActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/Theme.PersianAIAssistant.NoActionBar"
            android:windowSoftInputMode="stateHidden" />

        <service
            android:name=".services.FullScreenAlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".services.VoiceRecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".services.ReminderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
            
        <service
            android:name=".services.AIAssistantService"
            android:enabled="true"
            android:exported="false" />
            
        <service
            android:name=".services.MusicPlayerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
            
        <service
            android:name=".music.RealMusicService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".services.MessageAutomationService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name=".widgets.WidgetUpdateService"
            android:enabled="true"
            android:exported="false" />
            
        <service
            android:name=".service.FloatingVoiceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
            
        <receiver
            android:name=".widgets.PersianCalendarWidget"
            android:exported="true"
            android:label="ویجت متوسط">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_persian_calendar_info" />
        </receiver>

        <receiver
            android:name=".services.ReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.persianai.assistant.REMINDER_ALARM" />
                <action android:name="MARK_AS_DONE" />
                <action android:name="SNOOZE_REMINDER" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <receiver
            android:name=".receivers.VoiceCommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.persianai.assistant.action.RUN_COMMAND" />
                <action android:name="com.persianai.assistant.action.CANCEL_COMMAND" />
                <action android:name="com.persianai.assistant.action.EXECUTE_CALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.CallNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="MAKE_CALL" />
                <action android:name="OPEN_DIALER" />
                <action android:name="CHANGE_CONTACT" />
                <action android:name="SELECT_CONTACT" />
                <action android:name="REQUEST_CONTACTS_PERMISSION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
