<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recurringTitleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="توضیحات (اختیاری)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recurringDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Repeat Pattern -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="الگوی تکرار:"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/recurringPatternSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Pattern Info -->
        <TextView
            android:id="@+id/recurringPatternInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📌 روزانه: هر روز در ساعت مشخص شده"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Time Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/recurringSelectTimeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⏰ انتخاب ساعت"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Days Button (for custom pattern) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/recurringSelectDaysButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📅 انتخاب روزهای هفته"
            android:enabled="false"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Alert Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="نوع هشدار:"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/recurringAlertTypeChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRecurringAlertNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 نوتیفیکیشن"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRecurringAlertFullScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 آلارم تمام‌صفحه"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRecurringAlertSmart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 یادآوری هوشمند"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

</ScrollView>
